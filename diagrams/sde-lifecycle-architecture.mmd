graph LR
    P["1. PLAN - Goals / Scope / Risk"] --> R["2. REQUIREMENTS - URS / SRS / Acceptance"]
    R --> D["3. DESIGN - SDD / UML / Interfaces"]
    D --> B["4. DEVELOP - Code / Review / Build"]
    B --> T["5. TEST - Unit / Integration / System / UAT"]
    T --> X["6. DEPLOY - Release / Infrastructure / Rollback"]
    X --> M["7. MAINTAIN - Observe / Support / Improve"]
    M -. "Production evidence and feedback" .-> P
    C["Cross-cutting: Security / Documentation / Quality / Version control / Automation"]
    C -. "supports" .-> D
    C -. "supports" .-> T

    classDef plan fill:#e9f1fb,stroke:#2962a8,color:#122033,stroke-width:2px;
    classDef requirements fill:#e8f6f3,stroke:#18867f,color:#122033,stroke-width:2px;
    classDef design fill:#f0ecf8,stroke:#7658a8,color:#122033,stroke-width:2px;
    classDef build fill:#fff4e2,stroke:#d28b2f,color:#122033,stroke-width:2px;
    classDef test fill:#fbeae6,stroke:#d75c48,color:#122033,stroke-width:2px;
    classDef deploy fill:#ebf4ec,stroke:#4d8d5b,color:#122033,stroke-width:2px;
    classDef maintain fill:#e8edf2,stroke:#17324d,color:#122033,stroke-width:2px;
    classDef shared fill:#edf7f5,stroke:#18867f,color:#122033,stroke-dasharray:5 4;

    class P plan;
    class R requirements;
    class D design;
    class B build;
    class T test;
    class X deploy;
    class M maintain;
    class C shared;
